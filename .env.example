SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# 아래 항목은 브라우저에 노출하지 마세요. Sites Worker Secret으로만 설정하세요.
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL=claude-haiku-5-5, ANTHROPIC_MAX_OUTPUT_TOKENS=700
# OPENWEATHER_API_KEY=<OpenWeatherMap API 키>
# ANTHROPIC_CREDIT_USD=20, ANTHROPIC_DAILY_BUDGET_PERCENT=20, ANTHROPIC_USAGE_TIMEZONE=Asia/Seoul
# RATE_LIMIT_SALT=<32자 이상의 무작위 비밀값>, RATE_LIMIT_REQUESTS_PER_MINUTE=6
# SUPABASE_SERVICE_ROLE_KEY는 Edge Function 내장 Secret을 사용하며 브라우저 환경변수에 넣지 않습니다.
